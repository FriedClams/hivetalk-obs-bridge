{
  "manifest_version": 3,
  "name": "HiveTalk OBS Local Test",
  "version": "0.14.1",
  "description": "Exports up to four already-received HiveTalk participants to local OBS Browser Sources.",
  "host_permissions": [
    "https://*.hivetalk.org/*",
    "http://127.0.0.1:8766/*",
    "ws://127.0.0.1:8766/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "hivetalk-obs-local-test@local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.hivetalk.org/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.hivetalk.org/*"],
      "js": ["content-transport.js"],
      "run_at": "document_start"
    }
  ]
}
